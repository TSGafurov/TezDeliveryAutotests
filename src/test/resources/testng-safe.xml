<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
     CI-safe subset: только read-only тесты (group "safe"), не меняющие реальный аккаунт
     курьера, статус "Men tarmoqdaman" и заказы.

     Запуск: mvn test -DsuiteXmlFile=src/test/resources/testng-safe.xml
-->
<suite name="TezDelivery Suite (CI-safe)" verbose="1">
    <groups>
        <run>
            <include name="safe"/>
        </run>
    </groups>
    <listeners>
        <listener class-name="com.tezdelivery.tests.ScreenshotOnFailureListener"/>
        <listener class-name="com.tezdelivery.tests.RetryAnalyzerTransformer"/>
    </listeners>
    <test name="Orders">
        <classes>
            <class name="com.tezdelivery.tests.OrdersTest"/>
        </classes>
    </test>
    <test name="Notifications">
        <classes>
            <class name="com.tezdelivery.tests.NotificationsTest"/>
        </classes>
    </test>
    <test name="Profile">
        <classes>
            <class name="com.tezdelivery.tests.ProfileTest"/>
        </classes>
    </test>
</suite>
